generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id // Firebase UID
  email               String         @unique
  displayName         String
  city                String         @default("")
  neighbourhood       String         @default("")
  subscriptionTier    String         @default("free")
  subscriptionExpiry  DateTime?
  stripeCustomerId    String?        @unique
  pushToken           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  dogs                Dog[]
  pawRequestsSent     PawRequest[]   @relation("SentRequests")
  pawRequestsReceived PawRequest[]   @relation("ReceivedRequests")
  posts               Post[]
  businessReviews     BusinessReview[]
  adoptionApplications AdoptionApplication[]
  lostReports         LostReport[]
}

model Dog {
  id              String       @id
  ownerUid        String
  owner           User         @relation(fields: [ownerUid], references: [id], onDelete: Cascade)
  name            String
  breed           String
  gender          String
  dateOfBirth     DateTime
  weightKg        Float
  size            String
  photoURLs       String[]
  bio             String       @default("")
  traits          String[]
  badges          String[]
  energyLevel     String
  dogSocialPref   String
  humanSocialPref String
  isNeutered      Boolean      @default(false)
  isMicrochipped  Boolean      @default(false)
  vaccinated      Boolean      @default(false)
  moodStatus      String       @default("happy")
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  pawRequestsFrom PawRequest[] @relation("FromDog")
  pawRequestsTo   PawRequest[] @relation("ToDog")
  dismissedDogs   DogDismissal[] @relation("Dismisser")
  dismissedBy     DogDismissal[] @relation("Dismissed")
}

model PawRequest {
  id          String   @id @default(cuid())
  fromUid     String
  from        User     @relation("SentRequests", fields: [fromUid], references: [id])
  fromDogId   String
  fromDog     Dog      @relation("FromDog", fields: [fromDogId], references: [id])
  toUid       String
  to          User     @relation("ReceivedRequests", fields: [toUid], references: [id])
  toDogId     String
  toDog       Dog      @relation("ToDog", fields: [toDogId], references: [id])
  message     String   @default("")
  status      String   @default("pending")
  matchScore  Float    @default(0)
  channelId   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DogDismissal {
  id          String   @id @default(cuid())
  dogId       String
  dog         Dog      @relation("Dismisser", fields: [dogId], references: [id])
  targetDogId String
  target      Dog      @relation("Dismissed", fields: [targetDogId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([dogId, targetDogId])
}

model Post {
  id            String   @id @default(cuid())
  authorUid     String
  author        User     @relation(fields: [authorUid], references: [id])
  authorDogId   String
  type          String
  text          String   @default("")
  mediaURLs     String[]
  reactions     Json     @default("{}")
  commentCount  Int      @default(0)
  eventRef      String?
  lostReportRef String?
  adoptionRef   String?
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Event {
  id            String   @id @default(cuid())
  creatorUid    String
  title         String
  description   String
  category      String
  latitude      Float
  longitude     Float
  locationName  String
  address       String
  startAt       DateTime
  endAt         DateTime
  maxAttendees  Int?
  attendeeCount Int      @default(0)
  coverImageURL String?
  isPremiumOnly Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Business {
  id              String           @id @default(cuid())
  name            String
  category        String
  description     String
  address         String
  latitude        Float
  longitude       Float
  phone           String?
  website         String?
  photoURLs       String[]
  rating          Float            @default(0)
  reviewCount     Int              @default(0)
  openingHours    Json
  isPremiumPartner Boolean         @default(false)
  createdAt       DateTime         @default(now())

  reviews         BusinessReview[]
}

model BusinessReview {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  authorUid   String
  author      User     @relation(fields: [authorUid], references: [id])
  rating      Int
  text        String
  createdAt   DateTime @default(now())
}

model LostReport {
  id                  String   @id @default(cuid())
  reporterUid         String
  reporter            User     @relation(fields: [reporterUid], references: [id])
  dogName             String
  dogBreed            String
  dogPhotoURL         String
  dogDescription      String
  status              String   @default("lost")
  lastSeenLatitude    Float
  lastSeenLongitude   Float
  lastSeenAddress     String
  lastSeenAt          DateTime
  rewardOffered       Boolean  @default(false)
  rewardAmount        Float?
  contactPhone        String
  isBroadcast         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AdoptionDog {
  id              String               @id @default(cuid())
  shelterUid      String
  shelterName     String
  name            String
  breed           String
  gender          String
  ageMonths       Int
  weightKg        Float
  photoURLs       String[]
  bio             String
  traits          String[]
  isNeutered      Boolean
  isVaccinated    Boolean
  isMicrochipped  Boolean
  status          String               @default("available")
  applicationCount Int                 @default(0)
  createdAt       DateTime             @default(now())

  applications    AdoptionApplication[]
}

model AdoptionApplication {
  id          String      @id @default(cuid())
  dogId       String
  dog         AdoptionDog @relation(fields: [dogId], references: [id])
  applicantUid String
  applicant   User        @relation(fields: [applicantUid], references: [id])
  message     String
  status      String      @default("pending")
  createdAt   DateTime    @default(now())
}
